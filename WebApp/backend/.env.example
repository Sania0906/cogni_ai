# CognifyAI Unified Express Backend - Environment Variable Template
# Copy to .env for local development or configure in Render Dashboard (never commit .env).

# Runtime
NODE_ENV=development
PORT=5000

# Security & Session Secrets
JWT_SECRET=replace_with_a_64_char_random_secret

# Comma-separated allowed browser origins in production (leave empty in dev)
# Example: https://cognifyai-web.onrender.com
CORS_ALLOWED_ORIGINS=

# Supabase Configuration (server-side only; NEVER expose SERVICE_ROLE_KEY to clients)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
STORAGE_RESUME_BUCKET=resumes

# Private Python FastAPI ML Service Connection
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_SECRET=replace_with_shared_internal_ml_secret

# Optional Transactional SMTP Settings (Password Reset / Verification OTP)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_EMAIL=your-email@domain.com
SMTP_PASSWORD=replace_with_smtp_app_password

