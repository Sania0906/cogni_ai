{
  "name": "cognifyai-e2e-automation",
  "version": "1.0.0",
  "description": "Enterprise-grade Selenium WebDriver & Appium E2E Automation Framework for CognifyAI",
  "main": "tests/baseTest.js",
  "type": "module",
  "scripts": {
    "test": "mocha \"tests/**/*.spec.js\" --config config/mocha.config.cjs --timeout 60000",
    "test:chrome": "cross-env BROWSER=chrome HEADLESS=true npm run test",
    "test:chrome:headed": "cross-env BROWSER=chrome HEADLESS=false npm run test",
    "test:firefox": "cross-env BROWSER=firefox HEADLESS=true npm run test",
    "test:edge": "cross-env BROWSER=edge HEADLESS=true npm run test",
    "test:auth": "cross-env BROWSER=chrome HEADLESS=true mocha \"tests/e2e/auth.spec.js\" --config config/mocha.config.cjs",
    "test:forms": "cross-env BROWSER=chrome HEADLESS=true mocha \"tests/e2e/formValidation.spec.js\" --config config/mocha.config.cjs",
    "test:ui": "cross-env BROWSER=chrome HEADLESS=true mocha \"tests/e2e/uiComponents.spec.js\" --config config/mocha.config.cjs",
    "test:navigation": "cross-env BROWSER=chrome HEADLESS=true mocha \"tests/e2e/navigation.spec.js\" --config config/mocha.config.cjs",
    "test:mobile": "cross-env PLATFORM=android mocha \"tests/mobile/mobileE2E.spec.js\" --config config/mocha.config.cjs",
    "report:excel": "node scripts/generateExcelReports.js",
    "clean": "rimraf reports/screenshots/* reports/failures/* logs/*.log",
    "pretest": "node -e \"const fs=require('fs'); ['reports/failures','reports/screenshots','logs','excel'].forEach(d => fs.mkdirSync(d, {recursive:true}));\""
  },
  "keywords": [
    "selenium",
    "appium",
    "react",
    "e2e-testing",
    "page-object-model",
    "exceljs",
    "mochawesome",
    "winston",
    "cognifyai"
  ],
  "author": "CognifyAI QA Automation Team",
  "license": "ISC",
  "dependencies": {
    "appium": "^2.11.3",
    "chai": "^5.1.1",
    "chromedriver": "^131.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "geckodriver": "^4.5.3",
    "mocha": "^10.7.3",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "rimraf": "^6.0.1",
    "selenium-webdriver": "^4.26.0",
    "winston": "^3.15.0"
  }
}
