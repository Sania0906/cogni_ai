# ==============================================================================
# CognifyAI E2E Automation Configuration
# ==============================================================================

# Web Application Settings
BASE_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
BROWSER=chrome
HEADLESS=true
IMPLICIT_WAIT_MS=5000
EXPLICIT_WAIT_MS=15000
PAGE_LOAD_TIMEOUT_MS=30000

# Mobile Application Settings (Appium)
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
ANDROID_DEVICE_NAME=Pixel_7_Pro_API_34
ANDROID_PLATFORM_VERSION=14.0
APP_PACKAGE=host.exp.exponent
APP_ACTIVITY=host.exp.exponent.LauncherActivity
APK_PATH=../MobileApp/android/app/build/outputs/apk/release/app-release.apk

# Test Execution & Reporting
ENVIRONMENT=local
GENERATE_EXCEL_REPORT=true
CAPTURE_CONSOLE_LOGS=true
RETRY_COUNT=1
PARALLEL_WORKERS=2
